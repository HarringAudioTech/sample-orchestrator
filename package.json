{
  "name": "sample-orchestrator",
  "version": "1.0.0",
  "description": "Sample Orchestrator UI styling with Tailwind CSS and DaisyUI",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/static/css/input.css -o ./src/static/css/output.css",
    "watch:css": "tailwindcss -i ./src/static/css/input.css -o ./src/static/css/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "daisyui": "^4.4.19",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  }
}
