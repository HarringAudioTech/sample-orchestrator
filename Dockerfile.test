# Use the same base image as your main application
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    portaudio19-dev \
    libportaudio2 \
    libportaudiocpp0 \
    wait-for-it \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy all files first to ensure everything is available for editable install
COPY . .

# Create a minimal README.md if it doesn't exist
RUN if [ ! -f README.md ]; then echo "# Sample Orchestrator\n\nA sample orchestrator for audio processing." > README.md; fi

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install pytest pytest-cov pytest-mock pytest-asyncio

# Install the package in development mode with test dependencies
RUN pip install -e '.[test]'

# Make test scripts executable
RUN chmod +x /app/tests/init-db.sh

# Set the default command to run tests
CMD ["pytest", "tests/", "-v"]
