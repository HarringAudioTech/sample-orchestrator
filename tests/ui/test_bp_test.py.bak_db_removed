"""
Test for the test_bp blueprint route.
"""
import pytest
from flask import Flask
from src.ui.test_bp import test_bp

def create_test_app():
    app = Flask(__name__)
    app.register_blueprint(test_bp)
    return app

@pytest.fixture
def client():
    app = create_test_app()
    app.config["TESTING"] = True
    with app.test_client() as client:
        with app.app_context():
            yield client

def test_test_route(client):
    response = client.get("/test/test-route")
    assert response.status_code == 200
    data = response.get_json()
    assert data == {"message": "Test route is working!"}
