    assert "Imported Audio Files" not in response_data


def test_dashboard_project_exists_with_recordings(client: FlaskClient, db_session: SQLAlchemySession):
    """Test dashboard for an existing project with recordings."""
    # Create a project
    project = ProjectModel(name="UI Test Project 2", project_type=ProjectType.SAMPLE_PACK, description="Has recordings")
    db_session.add(project)
    db_session.commit()
    db_session.refresh(project)

    # Create recordings for this project
    rec1 = RecordingModel(
        name="audio_file_1.wav",
        file_path="/path/to/audio_1.wav",
        file_size_bytes=123456,
        file_format="wav",
        duration_seconds=10.5,
        sample_rate=44100,
        bit_depth=24,
        channels=2,
        status=RecordingStatus.PROCESSED
    )
    
    rec2 = RecordingModel(
        name="long_audio_sample.mp3",
        file_path="/another/path/long_audio_sample.mp3",
        file_size_bytes=7890123,
        file_format="mp3",
        duration_seconds=185.7,
        sample_rate=48000,
        bit_depth=16,
        channels=1,
        status=RecordingStatus.PROCESSED
    )
    
    rec3 = RecordingModel( # Recording with missing filesize/duration
        name="incomplete_meta.aif",
        file_path="/path/incomplete.aif",
        file_format="aif",
        file_size_bytes=None,
        duration_seconds=None,
        sample_rate=44100,
        bit_depth=24,
        channels=2,
        status=RecordingStatus.UPLOADED
    )
    
    # Append all recordings to the project
    project.recordings.extend([rec1, rec2, rec3])
    db_session.add_all([rec1, rec2, rec3])
    db_session.commit()
    db_session.refresh(rec1)
    db_session.refresh(rec2)
    db_session.refresh(rec3)

    response = client.get(f"/ui/dashboard/{project.id}")
    assert response.status_code == 200
    response_data = response.data.decode("utf-8")

    assert f"Project: {project.name}" in response_data
    assert "Imported Audio Files" in response_data
    assert "No recordings found" not in response_data

    # Check for rec1 details
    assert rec1.name in response_data
    expected_size_mb = f"{(rec1.file_size_bytes / 1024 / 1024):.2f}"
    assert expected_size_mb in response_data  # Check for formatted MB value
    # Check for formatted duration (MM:SS)
    expected_duration = f"{int(rec1.duration_seconds // 60):d}:{int(rec1.duration_seconds % 60):02d}"
    assert expected_duration in response_data

    # Check for rec2 details
    assert rec2.name in response_data
    expected_size_mb = f"{(rec2.file_size_bytes / 1024 / 1024):.2f}"
    assert expected_size_mb in response_data  # Check for formatted MB value
    # Check for formatted duration (MM:SS)
    expected_duration = f"{int(rec2.duration_seconds // 60):d}:{int(rec2.duration_seconds % 60):02d}"
    assert expected_duration in response_data

    # Check for rec3 details (handling None)
    assert rec3.name in response_data
    assert "N/A" in response_data # Check for how None file_size_bytes/duration is rendered

    # Check for recording names in the table
    assert rec1.name in response_data
    assert rec2.name in response_data
    assert rec3.name in response_data
    
    # Check for formatted file sizes
    expected_size_mb = f"{(rec1.file_size_bytes / 1024 / 1024):.2f}"
    assert expected_size_mb in response_data
    
    # Check for formatted durations
    expected_duration = f"{int(rec1.duration_seconds // 60):d}:{int(rec1.duration_seconds % 60):02d}"
    assert expected_duration in response_data
    
    # Check for N/A values for rec3 in the actual HTML structure
    # The template shows 'N/A MB' for None file_size_bytes and 'N/A' for None duration_seconds
    assert "N/A MB" in response_data  # For rec3's file_size_bytes
    assert "N/A" in response_data     # For rec3's duration_seconds

    assert "No recordings found" not in response_data

