@patch("src.core.stages.slicing_stage.sf.write")
@patch("src.core.stages.slicing_stage.librosa.onset.onset_detect")
@patch("src.core.stages.slicing_stage.librosa.load")
# pylint: disable=redefined-outer-name
def test_slicing_stage_min_max_sample_length(
    mock_librosa_load: MagicMock,
    mock_onset_detect: MagicMock,
    mock_sf_write: MagicMock,
    db_session: SQLAlchemySession,
    setup_test_recording: RecordingModel,
    temp_output_dir_for_samples: str,
    setup_sample_category: SampleCategory,
) -> None:
    """Test that min_sample_length_ms and max_sample_length_ms parameters are respected with enhanced Sample model."""
    recording: RecordingModel = setup_test_recording
    stage = SlicingStage()

    # Mock audio data - 5 seconds of audio at 22050Hz, mono
    mock_samplerate: int = 22050
    mock_audio_data_mono: np.ndarray = np.random.rand(mock_samplerate * 5).astype(
        np.float32
    )
    mock_librosa_load.return_value = (mock_audio_data_mono, mock_samplerate)

    # Define onsets in seconds: 0.5s, 0.52s (too short), 1.0s, 2.0s
    mock_onset_seconds = np.array([0.5, 0.52, 1.0, 2.0])
    mock_onset_samples: np.ndarray = (mock_onset_seconds * mock_samplerate).astype(int)
    mock_onset_detect.return_value = mock_onset_seconds

    # Set up mock file writing
    written_files = []

    def mock_write_side_effect(file_path, data, sr, **kwargs):
        os.makedirs(os.path.dirname(file_path), exist_ok=True)
        with open(file_path, "wb") as f:
            f.write(b"test")  # Write a small test file
        written_files.append(file_path)
        return file_path

    mock_sf_write.side_effect = mock_write_side_effect

    # Set up stage parameters for testing min/max length
    stage_params: Dict[str, Any] = stage.default_params.copy()
    stage_params.update(
        {
            "min_sample_length_ms": 50,  # 50ms minimum
            "max_sample_length_ms": 1000,  # 1 second maximum
            "category": setup_sample_category.name,
            "tags": ["test", "min-max-length"],
            "notes": "Test recording with min/max length constraints",
        }
    )

    context: Dict[str, Any] = {
        "db_session": db_session,
        "recording_id": recording.id,
        "project_id": recording.project_id,
        "output_dir": temp_output_dir_for_samples,
        "params": stage_params,
    }

    # Process the recording
    result_samples_info = stage.process(data=recording.file_path, context=context)

    # Verify the results
    db_session.refresh(recording)
    assert recording.status == "slicing_completed"

    # Should have 3 samples (one is too short and should be skipped)
    samples = (
        db_session.query(SampleModel)
        .filter_by(recording_id=recording.id)
        .order_by(SampleModel.start_time_seconds)
        .all()
    )
    assert len(samples) == 3
    assert len(result_samples_info) == 3
    assert mock_sf_write.call_count == 3
    assert len(written_files) == 3

    # First sample: 0.5s to 1.0s (0.5s duration, within min/max)
    assert abs(samples[0].end_time_seconds or 0 - 1.0) < 1e-6
    assert abs(samples[0].duration_seconds or 0 - 0.5) < 1e-6
    assert samples[0].sample_rate == mock_samplerate
    assert samples[0].bit_depth == 24
    assert samples[0].channels == 1
    assert samples[0].status == "processed"

    # Second sample: 1.0s to 2.0s (1.0s duration, at max length)
    assert abs(samples[1].start_time_seconds - 1.0) < 1e-6
    assert abs(samples[1].end_time_seconds - 2.0) < 1e-6
    assert abs(samples[1].duration_seconds - 1.0) < 1e-6

    # Third sample: 2.0s to end (3.0s duration, but should be truncated to 1.0s)
    assert abs(samples_sorted[2].start_time_seconds - 2.0) < 1e-6
    assert (
        abs(samples_sorted[2].end_time_seconds - 3.0) < 1e-6
    )  # Should be truncated to max 1s

    # Verify the sample that was too short (0.02s) was skipped
    assert not any(abs(s.start_time_seconds - 0.52) < 1e-6 for s in samples_sorted)

    # Verify all samples have the correct metadata
    for sample in samples_sorted:
        assert sample.project_id == recording.project_id
        assert sample.recording_id == recording.id
        assert sample.status == "processed"
        assert sample.is_processed is True
        assert "slice_index" in sample.metadata_json
        assert "source_onset_samples" in sample.metadata_json
        assert setup_sample_category.name in [c.name for c in sample.categories]
        assert "min-max-length" in sample.metadata_json.get("tags", [])
