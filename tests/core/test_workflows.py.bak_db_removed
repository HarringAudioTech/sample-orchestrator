def test_sample_pack_workflow_process_recording(mock_db_session, tmp_path):
    """Test the process_recording method of SamplePackWorkflow."""
    # Create a test workflow
    workflow = SamplePackWorkflow(mock_db_session)
    
    # Create a mock recording
    mock_recording = MagicMock()
    mock_recording.id = 1
    mock_recording.file_path = str(tmp_path / "recording.wav")
    mock_recording.status = "uploaded"
    
    # Create a mock project
    mock_project = MagicMock()
    mock_project.id = 1
    mock_project.name = "Test Project"
    
    # Configure the mock database session
    mock_db_session.query.return_value.filter.return_value.first.return_value = mock_recording
    
    # Mock the processing stages
    workflow.onset_detection = MagicMock()
    workflow.slice_planning = MagicMock()
    workflow.segment_classification = MagicMock()
    workflow.slicing = MagicMock()
    
    # Configure stage mocks to return test data
    workflow.onset_detection.process.return_value = {
        "onsets": [0.1, 0.5, 1.0],
        "duration": 1.5
    }
    
    workflow.slice_planning.process.return_value = {
        "slices": [
            {"start": 0.0, "end": 0.3, "type": "transient"},
            {"start": 0.3, "end": 0.8, "type": "sustain"},
            {"start": 0.8, "end": 1.5, "type": "release"}
        ]
    }
    
    workflow.segment_classification.process.return_value = {
        "segments": [
            {"start": 0.0, "end": 0.3, "label": "kick"},
            {"start": 0.3, "end": 0.8, "label": "snare"},
            {"start": 0.8, "end": 1.5, "label": "hihat"}
        ]
    }
    
    workflow.slicing.process.return_value = {
        "samples": [
            {"file_path": str(tmp_path / "output" / "sample1.wav"), "start": 0.0, "end": 0.3, "label": "kick"},
            {"file_path": str(tmp_path / "output" / "sample2.wav"), "start": 0.3, "end": 0.8, "label": "snare"},
            {"file_path": str(tmp_path / "output" / "sample3.wav"), "start": 0.8, "end": 1.5, "label": "hihat"}
        ]
    }
    
    # Call the method under test
    result = workflow.process_recording(
        recording_id=1,
        project_id=1,
        output_dir=str(tmp_path / "output")
    )
    
    # Verify the result
    assert result is not None
    assert "samples" in result
    assert len(result["samples"]) == 3
    
    # Verify the recording status was updated
    assert mock_recording.status == "processed"
    
    # Verify the database was committed
    mock_db_session.commit.assert_called_once()
    
    # Verify the processing stages were called with the correct arguments
    workflow.onset_detection.process.assert_called_once()
    workflow.slice_planning.process.assert_called_once()
    workflow.segment_classification.process.assert_called_once()
    workflow.slicing.process.assert_called_once()


def test_sample_pack_workflow_process_recording_not_found(mock_db_session, tmp_path):
    """Test process_recording when the recording is not found."""
    # Create a test workflow
    workflow = SamplePackWorkflow(mock_db_session)
    
    # Configure the mock database session to return None (recording not found)
    mock_db_session.query.return_value.filter.return_value.first.return_value = None
    
    # Call the method under test and verify it raises an exception
    with pytest.raises(ValueError, match="Recording not found"):
        workflow.process_recording(
            recording_id=999,  # Non-existent recording ID
            project_id=1,
            output_dir=str(tmp_path / "output")
        )
    
    # Verify the database was not committed
    mock_db_session.commit.assert_not_called()
